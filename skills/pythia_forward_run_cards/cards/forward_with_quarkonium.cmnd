! forward_with_quarkonium.cmnd -- forward flux including quarkonium.
!
! ONE inclusive run, with Onia switched on alongside the soft processes. This is
! deliberate and is NOT the same as running a dedicated onia sample separately:
!
!   * a minimum-bias sample produces quarkonium on its own, through string
!     fragmentation, with no NRQCD process enabled;
!   * a dedicated Onia sample has only the NRQCD production.
!
! Measured at 13.6 TeV / Monash, forward J/psi per inelastic collision:
!   this card (SoftQCD + Onia)   1.074e-3
!   dedicated Onia alone         8.07e-4    <- misses the fragmentation part
!   SoftQCD alone, Onia off      2.48e-4
! The two ingredients sum to the combined result, so this is addition, not
! double counting. Pythia still prints
!   "Warning in Pythia::init: should not combine softQCD processes with hard ones"
! which is aimed at SoftQCD+HardQCD (a real overlap, since MPI regenerates QCD
! 2->2). The onia process class is not regenerated by MPI. Verify for your own
! beam energy by checking the parts still sum to the whole -- see SKILL.md.
!
! Charmonium:all / Bottomonium:all are the narrower switches if you want only
! one family.

Beams:idA       = 2212
Beams:idB       = 2212
Beams:frameType = 1
Beams:eCM       = 13600.             ! CHANGE ME

Tune:pp         = 14                 ! Monash 2013

SoftQCD:inelastic = on               ! or SoftQCD:all, with the sigma_gen weight
HardQCD:all       = off              ! never on together with SoftQCD
Onia:all          = on

! Quarkonium is long-lived enough to be worth harvesting at production if you
! want the parent flux rather than its decay products.
! 443:mayDecay    = off              ! J/psi
! 100443:mayDecay = off              ! psi(2S)

Random:setSeed  = on
Random:seed     = 12345              ! CHANGE ME -- distinct per parallel job

Print:quiet                      = on
Next:numberCount                 = 0
Init:showChangedSettings         = off
Init:showChangedParticleData     = off
Init:showProcesses               = off
Init:showMultipartonInteractions = off
Check:event                      = off
